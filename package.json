{
  "name": "blog",
  "type": "module",
  "version": "1.11.4",
  "description": "Yet another blog",
  "private": true,
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11.12.1 <12"
  },
  "main": "dist/index.js",
  "scripts": {
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "start": "node tmp/index.cjs",
    "build:dev": "tsx scripts/build-dev.ts",
    "build:prod": "cross-env NODE_ENV=production tsx scripts/build-prod.ts",
    "clean": "del ./tmp && del ./build",
    "build": "npm run clean && npm run build:prod && cross-env NODE_ENV=production node tmp/index.cjs",
    "watch:dev": "tsx scripts/watch-dev.ts",
    "watch:node": "nodemon -d 300ms -e js,cjs,jpg,jpeg,png --watch content/images --watch tmp tmp/index.cjs",
    "watch:typecheck": "tsc --pretty --watch --noEmit --preserveWatchOutput",
    "watch": "concurrently -n \"BUILD,NODE,TS\" -c \"yellow,green,blue\" \"npm:watch:dev\" \"npm:watch:node\" \"npm:watch:typecheck\"",
    "prepare": "node -e \"try { require('husky').install() } catch (e) {if (e.code !== 'MODULE_NOT_FOUND') throw e}\"",
    "deploy": "gh-pages -d ./build"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:i9or/blog.git"
  },
  "keywords": [
    "blog"
  ],
  "author": "Igor <dont@bzzr.me> (https://ignorethis.page/)",
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@shikijs/transformers": "4.0.2",
    "@tinyhttp/app": "3.0.7",
    "@tinyhttp/logger": "2.1.0",
    "@types/markdown-it": "14.1.2",
    "@types/node": "24.12.2",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "4.1.5",
    "blog-css": "0.7.3",
    "concurrently": "9.2.1",
    "cross-env": "10.1.0",
    "dayjs": "1.11.20",
    "del-cli": "7.0.0",
    "esbuild": "0.28.0",
    "husky": "9.1.7",
    "lint-staged": "17.0.2",
    "markdown-it": "14.1.1",
    "markdown-it-attribution": "0.1.4",
    "markdown-it-attrs": "4.3.1",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-image-figures": "2.1.1",
    "nanoid": "5.1.11",
    "nodemon": "3.1.14",
    "prettier": "3.8.3",
    "sirv": "3.0.2",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vite": "8.0.11",
    "vitest": "4.1.5",
    "ws": "8.20.0"
  },
  "dependencies": {
    "chokidar": "5.0.0",
    "shiki": "4.0.2"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  }
}
